# =============================================================================
# FusionHeal — Environment Configuration Template
# Copy this file to '.env' for local development. NEVER commit '.env' to Git.
# =============================================================================

# --- 1. Core Application ---
APP_NAME=FusionHeal
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- 2. FastAPI Server ---
HOST=127.0.0.1
PORT=8000

# --- 3. Database Connection ---
# SQLite default for local prototyping:
DATABASE_URL=sqlite:///./fusionheal.db
# PostgreSQL / Supabase example for cloud deployment:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- 4. Sampling & Telemetry Timing Tolerances ---
DEFAULT_SAMPLING_INTERVAL_SECONDS=1.0
COMMUNICATION_GAP_MULTIPLIER=2.5
ALLOWED_CLOCK_SKEW_SECONDS=10.0
ENFORCE_WALL_CLOCK_SYNC=false

# --- 5. Data-Quality Detection Thresholds ---
FROZEN_CONSECUTIVE_COUNT=5
SPIKE_MAD_THRESHOLD=5.0
DRIFT_CUSUM_SLACK=0.5
DRIFT_CUSUM_THRESHOLD=5.0

# --- 6. Policy & Review Gates ---
POLICY_VERSION=1.0.0-horizonxt
RULE_CONFIG_VERSION=2026.1
AUTO_ACCEPT_REPAIRS=true
MIN_AUTO_ACCEPT_CONFIDENCE=0.80
MIN_REVIEW_CONFIDENCE=0.40
# Comma-separated list of sensors requiring mandatory human review before repair:
MANUAL_REVIEW_SENSORS=

# --- 7. Spatial-Temporal Transformer Model (External Weights) ---
# Path to separate ONNX or PyTorch weights (do not commit model binaries to git):
TRANSFORMER_MODEL_PATH=models/saits_spatial_temporal.onnx
TRANSFORMER_DEVICE=cpu

# --- 8. Supabase & Cloud Governance (Optional) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
