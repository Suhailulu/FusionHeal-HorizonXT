# FusionHeal - Environment Configuration
APP_NAME=FusionHeal
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Database Configuration (SQLite default; ready for PostgreSQL)
DATABASE_URL=sqlite:///./fusionheal.db

# Sampling and Detection Defaults
DEFAULT_SAMPLING_INTERVAL_SECONDS=1.0
COMMUNICATION_GAP_MULTIPLIER=2.5
FROZEN_CONSECUTIVE_COUNT=5
SPIKE_MAD_THRESHOLD=5.0
DRIFT_CUSUM_THRESHOLD=5.0
POLICY_VERSION=1.0.0-horizonxt
RULE_CONFIG_VERSION=2026.1
